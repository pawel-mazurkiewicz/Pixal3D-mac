@@ -353,6 +353,59 @@ def to_glb(
         grid=((valid_pos - aabb[0]) / voxel_size).reshape(1, -1, 3),
         mode='trilinear',
     )
+
+    # --- BAKE PROBE (env-gated, no-op by default) ------------------------
+    # Localises where base_color is lost: SOURCE field vs BVH projection vs
+    # trilinear sample.  Enable with PIXAL3D_BAKE_PROBE=1; dump tensors for
+    # offline analysis with PIXAL3D_BAKE_PROBE_DUMP=/path/probe.pt
+    import os as _os
+    if _os.environ.get("PIXAL3D_BAKE_PROBE", "").strip() in ("1", "true", "yes"):
+        import numpy as _np
+        _bc = attr_layout['base_color']
+
+        def _sat_stats(a):
+            a = a.detach().float().cpu().numpy()
+            mx = a.max(1); mn = a.min(1)
+            s = _np.where(mx > 1e-6, (mx - mn) / _np.maximum(mx, 1e-6), 0.0)
+            return float(s.mean()), float((s > 0.2).mean())
+
+        _src = attr_volume[:, _bc]
+        _ss, _fs = _sat_stats(_src)
+        print(f"[BAKE_PROBE] SOURCE attr_volume base_color: N={_src.shape[0]} "
+              f"meanRGB={_src.detach().float().mean(0).cpu().numpy().round(3)} "
+              f"meanSat={_ss:.3f} fracSat>0.2={_fs:.3f}", flush=True)
+        print(f"[BAKE_PROBE] SOURCE metallic mean={float(attr_volume[:, attr_layout['metallic']].float().mean()):.3f} "
+              f"roughness mean={float(attr_volume[:, attr_layout['roughness']].float().mean()):.3f}", flush=True)
+        try:
+            _d = _bvh_dist.detach().float().cpu().numpy()
+            print(f"[BAKE_PROBE] BVH unsigned_distance: mean={_d.mean():.6f} "
+                  f"p50={_np.median(_d):.6f} p99={_np.percentile(_d, 99):.6f} "
+                  f"max={_d.max():.6f} (voxel_size={float(voxel_size.float().mean()):.6f})", flush=True)
+        except Exception as _e:
+            print(f"[BAKE_PROBE] bvh dist unavailable: {_e}", flush=True)
+        _samp = attrs[mask][:, _bc]
+        _sm, _fm = _sat_stats(_samp)
+        _near0 = float((_samp.detach().float().abs().sum(1).cpu().numpy() < 0.03).mean())
+        print(f"[BAKE_PROBE] SAMPLED(pre-inpaint) base_color: nTexels={int(mask.sum())} "
+              f"meanRGB={_samp.detach().float().mean(0).cpu().numpy().round(3)} "
+              f"meanSat={_sm:.3f} fracSat>0.2={_fm:.3f} fracNear0={_near0:.3f}", flush=True)
+        _dp = _os.environ.get("PIXAL3D_BAKE_PROBE_DUMP", "")
+        if _dp:
+            torch.save({
+                "src_base_color": _src.detach().cpu(),
+                "src_metallic": attr_volume[:, attr_layout['metallic']].detach().cpu(),
+                "src_roughness": attr_volume[:, attr_layout['roughness']].detach().cpu(),
+                "sampled_attrs": attrs.detach().cpu(),
+                "mask": mask.detach().cpu(),
+                "bvh_dist": _bvh_dist.detach().cpu(),
+                "coords": coords.detach().cpu(),
+                "aabb": aabb.detach().cpu(),
+                "voxel_size": voxel_size.detach().cpu(),
+                "grid_size": grid_size.detach().cpu(),
+            }, _dp)
+            print(f"[BAKE_PROBE] dumped tensors to {_dp}", flush=True)
+    # --- end BAKE PROBE --------------------------------------------------
+
